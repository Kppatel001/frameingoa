# Public base URL (no trailing slash). Used for share links, OG tags, QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — enables "share link with live card preview" (dynamic OG).
# On Vercel: create a Blob store (Storage tab) and this is injected automatically.
BLOB_READ_WRITE_TOKEN=

# Optional — enables a persistent global "builders generated" counter + recent wall.
# On Vercel: add Upstash KV / Redis; these are injected automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
